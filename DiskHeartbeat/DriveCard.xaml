<UserControl x:Class="DiskHeartbeat.DriveCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="420" Foreground="#E8EFF2" FontFamily="Segoe UI" FontSize="12" Margin="0,0,12,12">
 <UserControl.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="10,4"/><Setter Property="Background" Value="#B6F2D6"/><Setter Property="Foreground" Value="#10251F"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ToolTip"><Setter Property="MaxWidth" Value="360"/></Style>
 </UserControl.Resources>
 <Border Background="#18242D" BorderBrush="#33454F" BorderThickness="1" CornerRadius="10" Padding="18">
 <StackPanel>
  <DockPanel><TextBlock x:Name="NameLabel" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="DriveType" Foreground="#9CAFB9" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
  <TextBlock Text="80-YEAR CLOCK" FontSize="10" Foreground="#9CAFB9" Margin="0,16,0,3" ToolTip="The manufacturer's rated write budget maps to 80 years. This is a visualization of the rating, not a health or failure prediction."/>
  <TextBlock x:Name="Clock" FontSize="28" FontWeight="Light"/>
  <TextBlock x:Name="Numbers" Margin="0,5,0,0" FontSize="12"/>
  <ProgressBar x:Name="Budget" Height="4" Margin="0,12,0,6" Maximum="100" Foreground="#87E1B4" ToolTip="Share of rated TBW consumed. The clock and recording continue beyond 100%."/>
  <TextBlock x:Name="Milestone" Foreground="#F5D69A"/>
  <Grid Margin="0,10,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition Height="12"/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
   <TextBlock Text="TODAY" FontSize="10" Foreground="#9CAFB9"/><TextBlock Text="AVERAGE" Grid.Column="1" FontSize="10" Foreground="#9CAFB9"/>
   <TextBlock x:Name="Today" Grid.Row="1" FontSize="15" Margin="0,3,8,0"/><TextBlock x:Name="Average" Grid.Row="1" Grid.Column="1" FontSize="15" Margin="0,3,0,0"/>
   <TextBlock x:Name="RunLabel" Text="THIS RUN" Grid.Row="3" FontSize="10" Foreground="#9CAFB9"/><TextBlock x:Name="RecordedLabel" Text="SINCE TRACKING BEGAN" Grid.Row="3" Grid.Column="1" FontSize="10" Foreground="#9CAFB9"/>
   <TextBlock x:Name="RunWrites" Grid.Row="4" FontSize="15" Margin="0,3,8,0"/><TextBlock x:Name="RecordedWrites" Grid.Row="4" Grid.Column="1" FontSize="15" Margin="0,3,0,0"/>
  </Grid>
  <TextBlock Text="Time to rated write limit at current pace" Foreground="#9CAFB9" FontSize="11" Margin="0,13,0,3" ToolTip="Remaining rated bytes divided by measured calendar-day pace. Requires 24 hours of compatible history, uses up to 30 days, and includes offline intervals. This is a constant-usage scenario, not a failure prediction."/>
  <TextBlock x:Name="Projection" Foreground="#9DDDBF"/>
  <DockPanel Margin="0,13,0,12"><Button Content="Save" Click="SaveRating" DockPanel.Dock="Right" Margin="6,0,0,0"/><TextBlock Text="Rated budget" VerticalAlignment="Center" ToolTip="Manufacturer-rated terabytes written (TBW), using decimal TB. Leave blank for unknown. Editing a rating changes only the clock, not recorded writes."/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox x:Name="Rating" Width="65" Padding="4,2"/><TextBlock Text=" TBW" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="#9CAFB9"/></StackPanel></DockPanel>
  <Border BorderBrush="#33454F" BorderThickness="0,1,0,0" Padding="0,12,0,0"><StackPanel>
   <DockPanel><TextBlock Text="What did that cost?" FontSize="14" VerticalAlignment="Center" ToolTip="All PC writes to this drive during a session. Start and stop each take a fresh device reading. If lifetime telemetry is unavailable, an explicitly observed ETW session may be available."/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Start" Content="Start" Click="StartSession" Margin="0,0,6,0"/><Button x:Name="Stop" Content="Stop" Click="StopSession" IsEnabled="False"/></StackPanel></DockPanel>
   <TextBlock x:Name="Session" Text="Ready" Margin="0,6,0,0"/>
  </StackPanel></Border>
  <TextBlock x:Name="Status" Foreground="#F5D69A" Margin="0,7,0,0"/>
  <Expander Header="Apps writing to this drive" Foreground="#9CAFB9" Margin="0,8,0,0"><StackPanel Margin="0,7,0,0">
   <ComboBox x:Name="SourceScope" SelectedIndex="0" SelectionChanged="ScopeChanged" Width="180" HorizontalAlignment="Left"><ComboBoxItem Content="This run"/><ComboBoxItem Content="Recorded totals"/><ComboBoxItem Content="Current / last session"/></ComboBox>
   <TextBlock x:Name="SourceRows" Foreground="#E8EFF2" Margin="0,7,0,0" ToolTip="Observed disk-write events grouped by executable name. Cache/filesystem writes may appear under System. ETW is a separate measurement and is not forced to match SMART. Only enabled, privileged recording periods are included."/>
  </StackPanel></Expander>
  <Expander Header="Drive details" Foreground="#9CAFB9" Margin="0,7,0,0"><StackPanel Margin="0,7,0,0">
   <Button Content="Read now" Click="ReadNow" HorizontalAlignment="Left" Margin="0,0,0,8"/>
   <TextBlock x:Name="CounterSource" Margin="0,0,0,6"/>
   <TextBlock x:Name="LastGood" Margin="0,0,0,6"/>
   <TextBlock x:Name="FirstTracked" Margin="0,0,0,6" ToolTip="First-use bound = telemetry timestamp minus accumulated power-on hours. Assumes an accurate, unreset counter. Powered-off/slumber time means actual first use can be earlier."/>
   <TextBlock x:Name="LifetimePace" Margin="0,0,0,6" ToolTip="Lifetime host bytes divided by power-on hours / 24. Includes pre-app writes, but is per powered-on day, not measured calendar-day history. Its separate projection assumes 24 h/day powered on."/>
   <TextBlock x:Name="Interval" Margin="0,0,0,6"/>
   <TextBlock x:Name="Gap"/>
  </StackPanel></Expander>
 </StackPanel>
 </Border>
</UserControl>
